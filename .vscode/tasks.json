
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build InternMatch",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-ICode",
                "Code/main.cpp",
                "Code/Student.cpp",
                "Code/Internship.cpp",
                "Code/LinkedList.cpp",
                "Code/MatchEngine.cpp",
                "Code/Person.cpp",
                "-o",
                "internmatch_test",
                "-lcurl"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
