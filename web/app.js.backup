
const form = document.getElementById("profileForm");
const resultsDiv = document.getElementById("results");
const submitBtn = document.getElementById("submitBtn");

form.addEventListener("submit", async function(event) {

    event.preventDefault();

    // Student profile collect karna
    const student = {
        name: document.getElementById("name").value.trim(),
        branch: document.getElementById("branch").value.trim(),
        year: parseInt(document.getElementById("year").value),
        cgpa: parseFloat(document.getElementById("cgpa").value),
        skills: document.getElementById("skills").value.trim()
    };

    // Loading message
    submitBtn.disabled = true;
    submitBtn.textContent = "Finding Matches...";
    resultsDiv.innerHTML = "<p>Fetching internships, please wait...</p>";

    try {

        // C++ backend ko profile bhejna
        const response = await fetch("/match", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify(student)
        });

        const data = await response.json();

        if (!response.ok) {
            throw new Error(data.error || "Something went wrong.");
        }

        // Results display karna
        resultsDiv.innerHTML = "";

        if (data.length === 0) {
            resultsDiv.innerHTML = "<p>No matching internships found.</p>";
            return;
        }

        data.forEach(function(internship, index) {

            const card = document.createElement("div");
            card.className = "result-card";

            const title = document.createElement("h3");
            title.textContent = `#${index + 1} ${internship.title}`;

            const company = document.createElement("p");
            company.textContent = `Company: ${internship.company}`;

            const skills = document.createElement("p");
            skills.textContent = "Skills: " + internship.skills.join(", ");

            const score = document.createElement("p");
            score.className = "score";
            score.textContent = `Match Score: ${internship.score}%`;

            card.appendChild(title);
            card.appendChild(company);
            card.appendChild(skills);
            card.appendChild(score);

            resultsDiv.appendChild(card);

        });

    }
    catch (error) {

        resultsDiv.innerHTML = "";

        const message = document.createElement("p");
        message.textContent = error.message;
        resultsDiv.appendChild(message);

    }
    finally {

        submitBtn.disabled = false;
        submitBtn.textContent = "Find Internships";

    }

});
